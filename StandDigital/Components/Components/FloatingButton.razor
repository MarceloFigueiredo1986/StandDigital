@if (ButtonClicked)
{
    <div class="floatingmenuUp">
        @MenuOptions
    </div>
}
@FloatButton

<style type="text/css">

    .floatingmenuUp{
        position: fixed;
        bottom: 75px;
        width: 150px;
        top:0px;
        bottom:0px;
        background-color: white;
        opacity: 1;
        padding:10px;
    }
</style>

@code {
    [Parameter]
    public RenderFragment FloatButton { get; set; }

    [Parameter]
    public RenderFragment MenuOptions { get; set; }

    [Parameter]
    public bool ButtonClicked { get; set; }
}
