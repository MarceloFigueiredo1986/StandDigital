@attribute [StreamRendering]

@inherits ProposalService

<div class="row">
@if(FinalPurposal is not null)
{
     @if (FinalPurposal.Paid)
     {
         <label><b><u>Proposta vencedora</u></b></label>
         <table>
             <tbody>
                 <tr>
                        <td><b>Comprador</b></td>
                     <td>@FinalPurposal.Buyer</td>
                 </tr>
                 <tr>
                        <td><b>Proposta</b></td>
                     <td>@FinalPurposal.Offer €</td>
                 </tr>
                 <tr>
                        <td><b>Telefone</b></td>
                     <td>@FinalPurposal.Telefone</td>
                 </tr>
             </tbody>
         </table>
     }
     else
     {
         <div>
             <label>Para ver a proposta vencedora, terá de fazer o pagamento de 50€.</label>
             <input type="button" class="btn btn-outline-dark" value="Requisitar código pagamento" @onclick="GetTokenForPayment" />
         </div>
     }
}
</div>
