<div class="inputValuesStyleDiv">
    <label for="firstName" class="form-label">Cilindrada</label>
    <input type="number" id="typeNumber" style="width:150px" class="form-control" @bind-value="Carro.Cilindrada" />
</div>
<div class="inputValuesStyleDiv">
    <label for="firstName" class="form-label">Combustível</label>
    @{
        int incr = 0;
        string flexRadioDefault;

        foreach (var caixa in CaixasVelocidade)
        {
            flexRadioDefault = $"flexRadioDefault{incr}";
            <div class="form-check" style="float:left">
                <input class="form-check-input" type="radio" name="flexRadioDefault" @onchange="() => {Carro.Caixa = caixa;}" id="@flexRadioDefault">
                <label class="form-check-label" for="@flexRadioDefault">
                    @caixa
                </label>
            </div>
            incr++;
        }
    }
</div>

@code {
    [Parameter]
    public CarEntity? Carro { get; set; }

    private string[] CaixasVelocidade => ["Manual", "Automática"];
}
