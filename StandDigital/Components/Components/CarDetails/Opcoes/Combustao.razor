<div class="inputValuesStyleDiv">
    <label for="firstName" class="form-label">Cilindrada</label>
    <input type="number" id="typeNumber" style="width:120px" class="form-control" @bind-value="Carro.Cilindrada" />
</div>
<div class="inputValuesStyleDiv">
    <label for="firstName" class="form-label">Caixa</label>
    @{

        foreach (var caixa in CaixasVelocidade)
        {
            string flexRadioDefault = $"flexRadioCaixa{Random.Shared.Next()}";
            <div class="form-check" style="float:left">
                <input class="form-check-input" type="radio" name="flexRadioCaixa" @onchange="() => {Carro.Caixa = caixa;}" id="@flexRadioDefault">
                <label class="form-check-label" for="@flexRadioDefault">
                    @caixa
                </label>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public CarAdvertisementCrudModel? Carro { get; set; }

    private string[] CaixasVelocidade => ["Manual", "Automática"];
}
