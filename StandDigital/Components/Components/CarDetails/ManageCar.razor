@page "/managecar/{carid:int}"
@page "/managecar"

@inherits CarDetailsService

@attribute [StreamRendering]

<input type="button" class="btn btn-outline-info" value="Voltar" style="margin-top:150px;margin-left:30px" @onclick="GoBack" />
<EditForm Model="Car" OnValidSubmit="ManageCommandToApply">
    <DataAnnotationsValidator />

    <div class="edit-form-container" style="background-color:white;width:90%">
        <ul class="nav nav-tabs">
            @foreach(var tab in Enum.GetValues<Tab>())
            {
                <li class="nav-item">
                    <a class="nav-link @(_tabuladorEscolhido == tab ? "active" : null)" 
                    aria-current="page" 
                    @onclick="() => _tabuladorEscolhido = tab"
                    style="cursor:pointer">@tab</a>
                </li>
            }
        </ul>
        <div style="padding:10px">
            @{
                switch (_tabuladorEscolhido)
                {
                    case Tab.Detalhes:
                        <div class="row justify-content-center">
                            <div class="col-md-12">
                                <div class="mb-12">
                                    <ComponentLoader LoadingObj="DefaultMarcas">
                                        <Fragment>
                                            <label for="firstName" class="form-label">Marca</label>
                                            <BlazoredTypeahead @onfocusout="CheckIfShouldClearModelsForLoading"  AddItemOnEmptyResultMethod="DefaultWhenBrandNotFound" SearchMethod="SearchBrand" @bind-Value="Car.Marca">
                                                <SelectedTemplate Context="contextA">
                                                    @contextA
                                                </SelectedTemplate>
                                                <ResultTemplate Context="contextA">
                                                    @contextA
                                                </ResultTemplate>
                                            </BlazoredTypeahead>
                                            <ValidationMessage For="@(() => Car.Marca)" />
                                            <span style="color:gray">Carregue em Enter para confirmar valor</span>
                                        </Fragment>
                                    </ComponentLoader>
                                </div>

                                <div class="mb-3" style="margin-top:15px">
                                    <p>
                                        <label for="firstName" class="form-label">Combustível</label>
                                    </p>
                                    <div class="row" style="margin:0px 10px 20px 10px">
                                        <InputRadioGroup Name="CombustivelGroup" @bind-Value="Car.Combustivel" @onfocusout="SetCombustivel">
                                         @foreach (var tipoCombustivel in Enum.GetValues(typeof(Combustivel)).Cast<Combustivel>().ToList())
                                        {
                                            string flexRadioDefault = $"flexRadioCombustivel{Random.Shared.Next()}";
                                            <div class="form-check" style="float:left;width:fit-content">
                                                    <InputRadio Name="CombustivelGroup" Value="tipoCombustivel.ToString()" />
                                                <label class="form-check-label" for="@flexRadioDefault">
                                                @tipoCombustivel.GetDescription()
                                                </label>
                                            </div>
                                        }
                                        </InputRadioGroup>
                                        <ValidationMessage For="@(() => Car.Combustivel)" />
                                    </div>
                                </div>

                                <div class="mb-3" disabled>
                                    <ComponentLoader LoadingObj="DefaultModelos">
                                        <Fragment>
                                            <label for="firstName" class="form-label">Modelo</label>
                                            <BlazoredTypeahead @onfocus="async () => await CheckIfShouldClearModelsForLoading()" SearchMethod="SearchModel" 
                                            @bind-Value="Car.Modelo" Disabled="Car.Marca is null || Car.Combustivel is null">
                                                <SelectedTemplate Context="contextB">
                                                    @contextB
                                                </SelectedTemplate>
                                                <ResultTemplate Context="contextB">
                                                    @contextB
                                                </ResultTemplate>
                                            </BlazoredTypeahead>
                                            <ValidationMessage For="@(() => Car.Modelo)" />
                                            <span>Carregue em Enter para confirmar valor</span>
                                        </Fragment>
                                    </ComponentLoader>
                                </div>

                                <div class="mb-3" style="height:70px">
                                    <div class="form-outline inputValuesStyleDiv">
                                        <div>
                                            <label for="firstName" class="form-label">Mês registo</label>
                                            <InputSelect style="font-size:11pt;padding:1px;text-align:left;max-width:110px;height:38px;margin:0px" id="department" @bind-Value="Car.MesRegisto">
                                                @foreach (var dept in MesesAno)
                                                {
                                                    <option value="@dept.Key">@dept.Value</option>
                                                }
                                            </InputSelect>
                                            <ValidationMessage For="@(() => Car.MesRegisto)" />
                                        </div>
                                    </div>
                                    <div class="form-outline inputValuesStyleDiv">
                                        <label for="firstName" class="form-label">Portas</label>
                                        <InputNumber id="typeNumberKms" style="width:120px" class="form-control" @bind-Value="Car.Portas" />
                                        <ValidationMessage For="@(() => Car.Portas)" />
                                    </div>
                                    <div class="form-outline inputValuesStyleDiv">
                                        <label for="firstName" class="form-label">Lotação</label>
                                        <InputNumber id="typeNumberKms" style="width:120px" class="form-control" @bind-Value="Car.Lotacao" />
                                        <ValidationMessage For="@(() => Car.Lotacao)" />
                                    </div>
                                    <div class="form-outline inputValuesStyleDiv">
                                        <label for="firstName" class="form-label">Quilómetros</label>
                                        <InputNumber id="typeNumberKms" style="width:120px" class="form-control" @bind-Value="Car.Kms" />
                                        <ValidationMessage For="@(() => Car.Kms)" />
                                    </div>
                                    <div class="inputValuesStyleDiv">
                                        <label for="firstName" class="form-label">Potência (Cv)</label>
                                        <InputNumber type="number" id="typeNumberCv" style="width:120px" class="form-control" @bind-Value="Car.Cv" />
                                        <ValidationMessage For="@(() => Car.Cv)" />
                                    </div>
                                    <div class="inputValuesStyleDiv">
                                        <label for="matricula" class="form-label">Matrícula</label>
                                        <InputText type="text"
                                               style="background-color:white;border-color:lightgray;border-width:0.5pt;margin:0px;height:38px;padding-left:1px;padding-right:1px"
                                               id="txtMatricula"
                                               class="form-control" @bind-Value="Car.Matricula" />
                                        <ValidationMessage For="@(() => Car.Matricula)" />
                                    </div>
                                    <div class="inputValuesStyleDiv">
                                        <label for="firstName" class="form-label">Ano registo</label>
                                        <InputNumber type="number" id="typeNumberAno" style="width:120px" class="form-control" @bind-Value="Car.Ano" />
                                        <ValidationMessage For="@(() => Car.Ano)" />
                                    </div>
                                    <div class="form-outline inputValuesStyleDiv">
                                        <div>
                                            <label for="firstName" class="form-label">1 Dono?</label>
                                            <InputSelect @bind-Value="Car.PrimeiroDono"
                                                         style="font-size:11pt;padding:1px;text-align:left;max-width:110px;height:38px;margin:0px" id="primeirodono">
                                                <option value="null">Escolher</option>
                                                <option value="1">Sim</option>
                                                <option value="0">Não</option>
                                            </InputSelect>
                                            <ValidationMessage For="@(() => Car.PrimeiroDono)" />
                                        </div>
                                    </div>
                                    <div class="form-outline inputValuesStyleDiv">
                                        <div>
                                            <label for="firstName" class="form-label">Nacional?</label>
                                            <InputSelect @bind-Value="Car.Nacional" DisplayName="Escolher"
                                                         style="font-size:11pt;padding:1px;text-align:left;max-width:110px;height:38px;margin:0px" id="primeirodono">
                                                <option value="null">Escolher</option>
                                                <option value="1">Sim</option>
                                                <option value="0">Não</option>
                                            </InputSelect>
                                            <ValidationMessage For="@(() => Car.Nacional)" />
                                        </div>
                                    </div>
                                    @if (MenuOpcoesTipoCombustivel is not null)
                                    {
                                        <DynamicComponent Type="@MenuOpcoesTipoCombustivel" Parameters="ParametrosComponenteOpcoesCombustivel" />
                                    }
                                </div>
                            </div>
                        </div>
                        break;
                    case Tab.Fotos:
                        <PhotosImporter Files="TemporaryPhotos" />
                        break;
                    case Tab.Extras:
                        <div class="mb-12">
                            @foreach (var extra in DefaultExtras)
                            {
                                var classStyle = Extras.Contains(extra.Nome) ? "success" : "outline-success";
                                <input style="margin:0.5px;font-size:10pt;padding:3px;margin:2px" type="button" class="btn btn-@classStyle" value="@extra.Nome" @onclick="() => ManageClickedExtra(extra.Nome)" />
                            }
                        </div>
                        break;
                    case Tab.EstadoViatura:
                        <!--Danos, Problemas motor, Comentários-->
                        <div class="row">
                            @{
                                <div style="float:left;width:350px" class="form-outline">
                                    <label for="firstName" class="form-label">Danos cosméticos conhecidos</label>
                                    <textarea class="form-control" aria-label="With textarea" style="min-height:110px;max-height:110px" maxlength="150" @bind="Car.Danos"></textarea>
                                </div>
                            }
                        </div>
                        <div class="row">
                            @{
                                <div style="float:left;width:350px" class="form-outline">
                                    <label for="firstName" class="form-label">Problemas mecânicos ou elétricos conhecidos</label>
                                    <textarea class="form-control" aria-label="With textarea" style="min-height:110px;max-height:110px" maxlength="150" @bind="Car.ProblemasMotor"></textarea>
                                </div>
                            }
                        </div>
                        <br />
                        <div class="row">
                            @{
                                <div style="float:left;width:350px" class="form-outline">
                                    <label for="firstName" class="form-label">Comentários relevantes</label>
                                    <textarea class="form-control" aria-label="With textarea" style="min-height:110px;max-height:110px" maxlength="150" @bind="Car.Comentarios"></textarea>
                                </div>
                            }
                        </div>
                        break;
                    case Tab.TipoNegocio:
                        <div class="mb-12" style="height:230px">
                            <div style="margin-top:15px">
                                <p>
                                    <label for="firstName" class="form-label">Tipo de anúncio</label>
                                </p>
                                <div class="row" style="margin:0px 10px 20px 10px">
                                    <InputRadioGroup Name="TiposNegociosGroup" @bind-Value="Car.TipoNegocioId">
                                        @{
                                            foreach (var tipoNegocio in TiposNegocios)
                                            {
                                                string flexRadioDefault = $"flexRadioTipoNegocio{Random.Shared.Next()}";
                                                <div class="form-check" style="float:left;width:180px;cursor:pointer">
                                                    <InputRadio Name="TiposNegociosGroup" Value="@tipoNegocio.TipoNegocioId" />
                                                    <label class="form-check-label" for="@flexRadioDefault">
                                                        @tipoNegocio.Name
                                                    </label>
                                                </div>
                                            }
                                        }
                                    </InputRadioGroup>
                                </div>
                                <div class="form-outline inputValuesStyleDiv">
                                    <label for="firstName" class="form-label">Preço base</label>
                                    <input type="number" id="typeNumberKms" style="width:150px" class="form-control" @bind-value="Car.PrecoBase" />
                                </div>
                            </div>
                        </div>
                        <Proposal CarroId="Carid??0" FinalPurposal="@WinningProposal" />
                        break;
                }
                
                <div class="row">
                    @if (isSaving)
                    {
                        <button class="btn btn-primary" type="button" disabled>
                            <span class="spinner-grow spinner-grow-sm" role="status" aria-hidden="true"></span>
                            A guardar...
                        </button>
                    }
                    else
                    {
                        <div class="row">
                            <button type="submit" style="margin:15px;width:100px" class="btn btn-primary">Guardar</button>
                        </div>
                        <span style="color:red;margin:2px">@error</span>
                    }
                </div>
            }
        </div>    
    </div>

</EditForm>

<style type="text/css">
    
    .inputValuesStyleDiv{
        width: 120px;
        float: left;
        margin-right: 15px;
        margin-bottom:20px;
    }

    .edit-form-container {
        border: 1px solid #ddd; /* Border color */
        border-radius: 8px; /* Border radius for rounded corners */
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Box shadow for a subtle lift */
        padding: 20px 10px 20px 10px; /* Padding inside the container */
        margin-top: 20px; /* Add margin to separate from the header */
        width:410px;
        margin:auto;
        margin-top:15px;
    }

        .edit-form-container .form-label {
            font-weight: bold; /* Make form labels bold */
        }
</style>
