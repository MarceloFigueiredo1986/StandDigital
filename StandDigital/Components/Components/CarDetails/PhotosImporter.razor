@using Newtonsoft.Json
@attribute [StreamRendering]

@inject IWebHostEnvironment _env;
@inject ILogger<PhotosImporter> _logger;

<div class="row">
        <label for="firstName" class="form-label" style="float:left">Fotos</label>
        <InputFile id="inputDrop" OnChange="HandleImageSelected" OnError= style="float:left" />
        
        @if (isLoading)
        {
            <Loader />
        }
        else
        {
            <p style="color:forestgreen;float:left">Escolha a imagem a usar como principal</p>
            <span style="color:red">@GetMessage()</span>
            <div class="row" style="float:left">
                @foreach (var foto in Files)
                {
                    <div class="row">
                    <img src="@foto.AbsoluteNameWithPath" style="float:left" />
                    <span style="cursor:pointer;color:red;font-weight:bolder;margin-right:15px"
                          @onclick="() => RemoveImage(foto)">X</span>

                    @if (!foto.MainImage)
                    {
                        <span style="cursor:pointer;color:forestgreen;font-weight:bolder"
                              @onclick="() => ManageMainImage(foto)">definir</span>
                    }
                    else
                    {
                        <span style="cursor:pointer;color:darkolivegreen;font-weight:bolder">principal</span>
                    }
                </div>
                }
            </div>
        }
</div>


@code {

    [Parameter]
    public List<ImageUpload> Files { get; set; }

    [Parameter]
    public List<CarPhotoEntity> ExistingFiles { get; set; }

    [Parameter]
    public EventCallback<Dictionary<string, string>> FilesChanged { get; set; }

    private long maxFileSize = 1024 * 3072; //3MB max
    private int maxAllowedFiles = 1;
    private bool isLoading;
    private decimal progressPercent;
    private string? errorLoadingImages;
    private string folderPath => Path.Combine(_env.ContentRootPath, "temporaryfiles");
    private string[] imageExtensions = [".jpg",".png",".jpeg"];

    private string? GetMessage()
    {
        try
        {
            return errorLoadingImages != null ?
            string.Join(" ", errorLoadingImages.Split(';').ToList().Select(a => $"{a} {System.Environment.NewLine}")) :
        null;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Erro ao carregar imagens;");
        }

        return null;
    }

    private void ManageMainImage(ImageUpload image)
    {
        Files.ForEach(a => a.MainImage = false);
        image.MainImage = true;
    }
    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        try
        {
            isLoading = true;
            errorLoadingImages = null;

            if(e.FileCount > maxAllowedFiles)
            {
                errorLoadingImages = $"Escolha apenas {e.FileCount} de cada vez;";
                return;
            }

            if (!Directory.Exists(folderPath))
                Directory.CreateDirectory(folderPath);

            foreach (var file in e.GetMultipleFiles(maxAllowedFiles))
            {
                try
                {
                    if (!imageExtensions.Contains(file.Name.Substring(file.Name.LastIndexOf('.'))))
                    {
                        errorLoadingImages += $"Ficheiro {file.Name} com extensão invalida;";
                        continue;
                    }

                    if(file.Size > maxFileSize)
                    {
                        errorLoadingImages += $"Ficheiro deve ter menos de 3.14 MB";
                        continue;
                    }

                    var trustedFileName = Path.GetRandomFileName();
                    var path = Path.Combine(folderPath, trustedFileName);

                    await using FileStream fs = new(path, FileMode.Create);
                    await file.OpenReadStream(maxFileSize).CopyToAsync(fs);
                    var image = new ImageUpload() { AbsoluteNameWithPath = path, ImageName = file.Name };

                    _logger.LogInformation("Image created with details {imagedetails};",  JsonConvert.SerializeObject(image));

                    Files.Add(image);
                }
                catch (Exception ex)
                {
                    _logger.LogWarning(ex,"File: {Filename} failed upload;", file.Name);
                    errorLoadingImages += $"{ex.Message.Substring(0, 100)};";
                }
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Erro ao carregar imagens;");
            errorLoadingImages += $"{ex.Message.Substring(0, 100)};";
        }
        finally
        {
            isLoading = false;
        }
    }

    protected void RemoveImage(ImageUpload image)
    {
        try
        {
            File.Delete(image.AbsoluteNameWithPath);
            Files.Remove(image);
            _logger.LogDebug("Foto {Photo} apagada", image.AbsoluteNameWithPath);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Erro removing image with absolute name {Image}", image.AbsoluteNameWithPath);
        }
    }
}
