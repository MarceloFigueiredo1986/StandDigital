<div class="maindivcarousel">
    @if (Photos != null)
    {
        <img width="@_WidthStr" height="100%" src="@Photos[_selectedImg]" />
        <input type="button" class="btn btn-outline-secondary imgsequence" id="previmg" 
        @onclick="() => { _selectedImg = Convert.ToUInt16((_selectedImg -1)  == -1 ? _selectedImg : (_selectedImg -1));}" value="Anterior" />
        <input type="button" class="btn btn-outline-secondary imgsequence" style="float:right;" id="nextimg"
               @onclick="() => { _selectedImg = Convert.ToUInt16((_selectedImg +1)  == Photos.Count() ? _selectedImg : (_selectedImg +1));}" value="Próxima" />
    }
</div>

<style type="text/css">
    .imgconfigmin {
        height: 80px;
        width: 80px;
        margin:3px 4.5px 3px 3px;
        cursor:pointer;
    }

    .maindivcarousel{
        height:350px;
        margin:5px;
    }

    .imgsequence{
        margin-top:5px;
        cursor:pointer;
    }
</style>

@code {
    ushort _selectedImg;

    [EditorRequired]
    [Parameter]
    public string[]? Photos { get; set; }

    [CascadingParameter]
    public int WindowWidth { get; set; }

    string? _WidthStr;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (WindowWidth == 0 || _WidthStr is not null) return;

        _WidthStr = WindowWidth switch
        {
            0 => $"{400}px",
            >= 560 => $"{530}px",
            (> 350 and < 560) => $"{WindowWidth - 30}px",
            < 350 => $"{(WindowWidth - 10)}px",
            _ => $"{400}px",
        };

        await InvokeAsync(StateHasChanged);
    }
}
