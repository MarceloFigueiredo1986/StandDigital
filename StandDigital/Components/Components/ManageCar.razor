@page "/managecar/{carid:int}"
@page "/managecar"

@using SixLabors.ImageSharp
@using SixLabors.ImageSharp.Formats
@using SixLabors.ImageSharp.Formats.Jpeg
@using SixLabors.ImageSharp.Formats.Png
@using SixLabors.ImageSharp.Processing

@attribute [StreamRendering]

@if(isSaving)
{
    <span>A gravar...</span>
}else
{
    <EditForm Model="Car" OnSubmit="ManageCommandToApply">
        <div class="edit-form-container">
            <div class="row justify-content-center">
                <div class="col-md-12">
                    <div class="mb-12">
                        <label for="firstName" class="form-label">Marca</label>
                        <BlazoredTypeahead SearchMethod="SearchBrand" @bind-Value="Car.Marca">
                            <SelectedTemplate Context="contextA">
                                @contextA
                            </SelectedTemplate>
                            <ResultTemplate Context="contextA">
                                @contextA
                            </ResultTemplate>
                        </BlazoredTypeahead>
                        <ValidationMessage For="@(() => Car.Marca)" />
                    </div>

                    <div class="mb-3" style="margin-top:15px">
                        <p>
                            <label for="firstName" class="form-label">Combustível</label>
                        </p>
                        <div class="row" style="margin:0px 10px 20px 10px">
                            @{
                                int incr = 0;
                                string flexRadioDefault;

                                foreach (var tipoCombustivel in Enum.GetValues(typeof(Combustivel)).Cast<Combustivel>().ToList())
                                {
                                    flexRadioDefault = $"flexRadioDefault{incr}";
                                    <div class="form-check" style="float:left;width:170px;">
                                        <input class="form-check-input" type="radio" name="flexRadioDefault" @onchange="() => SetCombustivel(tipoCombustivel)" id="@flexRadioDefault">
                                        <label class="form-check-label" for="@flexRadioDefault">
                                            @tipoCombustivel.GetDescription()
                                        </label>
                                    </div>
                                    incr++;
                                }
                            }
                        </div>
                    </div>

                    <div class="mb-3" disabled>
                        <label for="firstName" class="form-label">Modelo</label>
                        <BlazoredTypeahead SearchMethod="SearchModel" @bind-Value="Car.Modelo" Disabled="Car.Marca is null || Car.Combustivel is null">
                            <SelectedTemplate Context="contextB">
                                @contextB
                            </SelectedTemplate>
                            <ResultTemplate Context="contextB">
                                @contextB
                            </ResultTemplate>
                        </BlazoredTypeahead>
                        <ValidationMessage For="@(() => Car.Modelo)" />
                    </div>

                    <div class="mb-3" disabled>
                        <label for="firstName" class="form-label">Lotação</label>
                        <div class="slidecontainer">
                            <input type="range" class="form-range" min="1" max="10" style="width:340px;padding-top:15px;margin-left:5px" id="customRange22" oninput="this.nextElementSibling.value = this.value" @bind-value="Car.Lotacao">
                            <output>@Car.Lotacao</output>
                        </div>
                    </div>

                    <div class="mb-3" disabled>
                        <label for="firstName" class="form-label">Portas</label>
                        <div class="slidecontainer">
                            <input type="range" class="form-range" min="1" style="width:340px;padding-top:15px;margin-left:5px" max="5" id="customRange232" oninput="this.nextElementSibling.value = this.value" @bind-value="Car.Portas">
                            <output>@Car.Portas</output>
                        </div>
                    </div>

                    <div class="mb-3" disabled>
                        <div class="slidecontainer">
                            <label for="firstName" class="form-label" style="width:400px">Ano registo</label>
                            <input type="number" id="typeNumber" class="form-control" @bind-value="Car.Ano" />
                        </div>
                    </div>

                    <div class="mb-3" disabled>
                        <div class="slidecontainer">
                            <label for="firstName" class="form-label" style="width:400px">Mês registo</label>
                            <input type="range" class="form-range" min="1" style="width:340px;padding-top:15px;margin-left:5px" max="12" oninput="this.nextElementSibling.value = this.value" id="customRange5fds" @bind-value="Car.MesRegisto">
                            <output>@Car.MesRegisto</output>
                        </div>
                    </div>

                    <div class="mb-3" disabled>
                        <div class="slidecontainer">
                            <label for="firstName" class="form-label" style="width:400px">Potência (Cv)</label>
                            <input type="number" id="typeNumber" class="form-control" @bind-value="Car.Cv" />
                        </div>
                    </div>

                    <div class="mb-3" disabled>
                        <div class="form-outline">
                            <label for="firstName" class="form-label" style="width:400px">Preço</label>
                            <input type="number" id="typeNumber" class="form-control" @bind-value="Car.Preco" />
                        </div>
                    </div>

                    <div class="mb-3" disabled>
                        <label for="firstName" class="form-label">Carro novo?</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio1" @onclick="() => DefineCondicao(false)" />
                            <label class="form-check-label" for="inlineRadio1">Não</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio2" @onclick="() => DefineCondicao(true)" />
                            <label class="form-check-label" for="inlineRadio2">Sim</label>
                        </div>
                    </div>

                    <PhotosImporter Files="TemporaryPhotos" />

                    <div class="row">
                        <button type="submit" style="margin:15px;width:100px" class="btn btn-primary">Save</button>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
}

<style type="text/css">

    .edit-form-container {
        border: 1px solid #ddd; /* Border color */
        border-radius: 8px; /* Border radius for rounded corners */
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Box shadow for a subtle lift */
        padding: 20px 10px 20px 10px; /* Padding inside the container */
        margin-top: 20px; /* Add margin to separate from the header */
        width:410px;
        margin:auto;
        margin-top:15px;
    }

        .edit-form-container .form-label {
            font-weight: bold; /* Make form labels bold */
        }

    .divFoto{
        width: 400px;
        height:55px;
        float:left;
    }
</style>

@code
{
    private Dictionary<string, string> TemporaryPhotos { get; set; } = new();

    protected CarEntity Car { get; set; } = new();

    [Parameter]
    public int? Carid { get; set; }

    public ImmutableArray<string> Marcas => ["Mercedes-Benz", "Audi", "Bmw", "VW", "Seat", "Byd"];
    public (string Marca, string Combustivel, ImmutableArray<string> Modelos)[] Modelos => new(string, string, ImmutableArray<string>)[]
    {
        ("Mercedes-Benz",Combustivel.Gasoleo.ToString(),["A","B","C","E","S","CLS","CLA","CLC"] ),
        ("Audi",Combustivel.Gasoleo.ToString(),["A1","A2","A3","A4","A5","A6","A7","A8"] ),
        ("Bmw",Combustivel.Gasoleo.ToString(),["Série 1","Série 2","Série 3","Série 4","Série 5","Série 6","Série 8","X1","X2","X3","X4","X5","X6"] ),
        ("VW",Combustivel.Gasolina.ToString(),["Golf","Passat","Lupo","Amarok"] ),
        ("Byd",Combustivel.Electrico.ToString(),["Seal"] )
    };

    private bool isSaving;

    private async Task<IEnumerable<string>> SearchBrand(string searchText) 
    => await Task.FromResult(Marcas.Where(x => x.ToLower().Contains(searchText.ToLower())).Order().ToList());
    private async Task<IEnumerable<string>> SearchModel(string searchText)
    {
        var modelosFiltrados = Modelos.
        Where(a => a.Marca == Car.Marca).
        Where(aa => aa.Combustivel == Car.Combustivel).
        Select(aaa => aaa.Modelos).First();
        return await Task.FromResult(modelosFiltrados.Where(x => x.ToLower().Contains(searchText.ToLower())).Order().ToList());
    }
    private void SetCombustivel(Combustivel Combustivel)
        => Car.Combustivel = Combustivel.ToString();

    protected void DefineCondicao(bool estadoNovo) => Car.Condicao = estadoNovo switch
    {
        true => "Novo",
        false => "Usado"
    };

    protected async Task ManageCommandToApply(EditContext editContext)
    {
        try
        {
            isSaving = true;
            if (Carid is null)
                await CreateCar();
            else
                await EditCar();

        }
        catch (Exception ex)
        {

            throw;
        }
        finally
        {
            isSaving = false;
        }
    }
    protected async Task CreateCar()
    {
        await Task.Delay(5000);
    }
    protected Task EditCar()
    {
        throw new NotImplementedException();
    }
}