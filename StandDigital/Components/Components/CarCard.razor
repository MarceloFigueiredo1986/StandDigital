
@attribute [StreamRendering]
@inject NavigationManager navMan

<div class="CardMain" style="width:@_viewWidthStr">
    <img src="@Carro.MainImage.ImageStringBase64()" height="250">
    <div class="down-content">
        <h4>@Carro.Marca @Carro.Modelo</h4>
        <h6>
            <span style="color:gray;margin-right:15px">@Carro.Combustivel</span>
            <span style="margin-right:15px">@Carro.Kms kms</span>
            <span style="float:right">@Carro.MesRegisto.ToString().PadLeft(2, '0') / @Carro.Ano</span>
        </h6>
        <p>
            <span>@(!string.IsNullOrEmpty(Carro.Danos) ? "Tem marcas de uso na carroceria" : "Sem danos externos")</span>
        </p>
        <p>
            <span>@(!string.IsNullOrEmpty(Carro.ProblemasMotor) ? "Precisa de validação interior e/ou motor" : "Sem danos de interior e/ou motor")</span>
        </p>
        <div class="row">
            <div class="col-3">
                <div style="margin-top:5px;width:90px">
                    <span style="float:left;margin-right:15px">@(Carro.Nacional == 1 ? "Nacional" : "Importado")</span>
                    <span style="float:left;margin-right:15px">@(Carro.PrimeiroDono == 1 ? "1 dono" : "2 ou + donos")</span>
                </div>
            </div>
            <div class="col-5">
                <div style="margin-top:3px;">
                    <span style="float:right;padding-right:5px;width:130px;text-align:right;padding-top:1px;height:20px"><b>@Carro.DiasParaFimAnuncio para terminar</b></span>
                </div>
            </div>
            <div class="col-4" style="margin-top:10px">
                <input type="button" class="btn btn-outline-danger" style="float:right;" value="Saber mais" 
                @onclick="() => navMan.NavigateTo(Path.Combine(
                                navMan.BaseUri,CaminhosComponentes.DetalhesNegocio.GetDescription(),
                                InvokingEndpoint.GetDescription(),
                                Carro.CarroId.ToString()))" />
            </div>
        </div>
    </div>
</div>

<style type="text/css">
    .CardMain {
        padding:15px;
        margin: 10px;
        float: left;
        border-radius: 10px;
        background-color: whitesmoke;
        margin: auto;
        margin-bottom: 10px;
    }

</style>

@code {
    [Parameter]
    public CarCardModel Carro { get; set; }

    [CascadingParameter]
    public int WindowWidth { get; set; }

    [CascadingParameter]
    public CaminhosComponentes InvokingEndpoint { get; set; }

    string? _viewWidthStr;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (WindowWidth == 0 || _viewWidthStr is not null) return;

        _viewWidthStr = WindowWidth switch
        {
            0 => $"{400}px",
            >= 560 => $"{530}px",
            (> 350 and < 560) => $"{WindowWidth - 30}px",
            < 350 => $"{(WindowWidth - 10)}px",
            _ => $"{400}px",
        };

        await InvokeAsync(StateHasChanged);
    } 
}