@attribute [StreamRendering]

@inject IWebHostEnvironment _env;
@implements IDisposable

<div class="row">
    <div class="mb-3">
        <label for="firstName" class="form-label">Fotos</label>
        <InputFile id="inputDrop" OnChange="OnChangeCarPhotoDrop" multiple />

        @if (isLoading)
        {
            <p>A carregar...</p>
        }
        else
        {
            @foreach (var foto in Files)
            {
                <div style="height:15px;font-size:10pt">
                    <span style="font-size:10pt">@foto.Value</span><span style="cursor:pointer;color:red;font-weight:bolder" @onclick="() => RemoveImage(foto.Key)">X</span>
                </div>
            }
            <span style="color:red">@errorLoadingImages</span>
        }
    </div>
</div>


@code {

    [Parameter]
    public Dictionary<string, string> Files { get; set; }

    [Parameter]
    public EventCallback<Dictionary<string, string>> FilesChanged { get; set; }

    private long maxFileSize = 1024 * 7000;
    private int maxAllowedFiles = 30;
    private bool isLoading;
    private decimal progressPercent;
    private string? errorLoadingImages;

    private async Task OnChangeCarPhotoDrop(InputFileChangeEventArgs e)
    {
        isLoading = true;
        Files.Clear();
        errorLoadingImages = null;

        if(e.FileCount > maxAllowedFiles)
        {
            errorLoadingImages = $"Maximum number of images is {e.FileCount}";
            return;
        }

        foreach (var file in e.GetMultipleFiles(maxAllowedFiles))
        {
            try
            {
                var filename = $"{file.Name}__{Guid.NewGuid()}";
                var path = Path.Combine(_env.ContentRootPath, "temporaryfiles",filename);
                await using FileStream fs = new(path, FileMode.Create);
                await file.OpenReadStream(maxFileSize).CopyToAsync(fs);
                Files.Add(filename,file.Name);
            }
            catch (Exception ex)
            {
                Console.WriteLine("File: {Filename} Error: {Error}", file.Name, ex.Message);
            }
        }

        isLoading = false;
    }
    protected void RemoveImage(string imageName)
    {
        try
        {
            File.Delete(Path.Combine(_env.ContentRootPath, "temporaryfiles",
                    imageName));

            Files.Remove(imageName);
        }
        catch (Exception ex)
        {
            Console.WriteLine("File: {Filename} Error: {Error}", imageName, ex.Message);
        }
    }
    public void Dispose()
    {
        var tsk = new Thread(a => 
             {
                 Files.ToList().ForEach(a =>
                 {
                     File.Delete(Path.Combine(_env.ContentRootPath, "temporaryfiles",
                            a.Key));
                 });
             });
        tsk.Start();
    }
}
