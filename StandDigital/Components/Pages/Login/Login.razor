@page "/login"

<div class="wrapper fadeInDown" style="margin:auto;margin-top:150px">
    @if (MenuEscolhido is MenusLogin.Login)
    {
        <LoginForm @bind-ChoosedMenu="MenuEscolhido" />
    }
    else
    {
        <StandDigital.Components.Pages.Login.CriarConta.CriarContaForm @bind-ChoosedMenu="MenuEscolhido" />
    }
</div>

@code{
    public MenusLogin MenuEscolhido { get; set; }

    public enum MenusLogin
    {
        Login,
        CriarConta
    };
}