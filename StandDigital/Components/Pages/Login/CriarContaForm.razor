@using static StandDigital.Components.Pages.Login.Login
@inject ILogger<CriarContaForm> _logger

<div id="formContent">
    <div style="padding-top:15px;padding-bottom:15px">
        <div class="row justify-content-center" style="padding:5px">
            <EditForm Model="_user" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <h4 style="color:gray">Criar Conta</h4>

                <div class="row inputValuesStyleDiv">
                    <label class="form-label labelStyle">Nome</label>
                    <InputText class="form-control elementStyle" @bind-Value="_user.Name" tabindex="1" />
                    <ValidationMessage For="@(() => _user.Name)" class="validationfieldstyle" />
                </div>

                <div class="row inputValuesStyleDiv">
                    <label class="form-label labelStyle">Morada</label>
                    <InputText class="form-control elementStyle" @bind-Value="_user.Address" tabindex="1" />
                    <ValidationMessage For="@(() => _user.Address)" class="validationfieldstyle" />
                </div>

                <div class="row inputValuesStyleDiv">
                    <label class="form-label labelStyle">Nome utilizador</label>
                    <InputText class="form-control elementStyle" @bind-Value="_user.Username" tabindex="1" />
                    <ValidationMessage For="@(() => _user.Username)" class="validationfieldstyle" />
                </div>

                <div class="row inputValuesStyleDiv">
                    <label class="form-label labelStyle">Email</label>
                    <InputText class="form-control elementStyle" @bind-Value="_user.Email" tabindex="1" />
                    <ValidationMessage For="@(() => _user.Email)" class="validationfieldstyle" />
                </div>

                <div class="row inputValuesStyleDiv">
                    <label class="form-label labelStyle">Telefone</label>
                    <InputNumber class="form-control elementStyle" @bind-Value="_user.Mobile" tabindex="1" />
                    <ValidationMessage For="@(() => _user.Mobile)" class="validationfieldstyle" />
                </div>

                <div class="row inputValuesStyleDiv">
                    <label class="form-label labelStyle">NIF</label>
                    <InputText class="form-control elementStyle" @bind-Value="_user.NIF" tabindex="1" />
                    <ValidationMessage For="@(() => _user.NIF)" class="validationfieldstyle" />
                </div>

                <div class="row inputValuesStyleDiv">
                    <label class="form-label labelStyle">Password</label>
                    <InputText class="form-control elementStyle" @bind-Value="_user.Password" tabindex="1" />
                    <ValidationMessage For="@(() => _user.Password)" class="validationfieldstyle" />
                </div>

                <div class="row inputValuesStyleDiv">
                    <label class="form-label labelStyle">Confirmar Password</label>
                    <InputText class="form-control elementStyle" @bind-Value="_user.ConfirmPassword" tabindex="1" />
                    <ValidationMessage For="@(() => _user.ConfirmPassword)" class="validationfieldstyle" />
                </div>

                <div class="row inputValuesStyleDiv">
                    @if (_isSaving)
                    {
                        <button class="btn btn-primary" type="button" disabled>
                            <span class="spinner-grow spinner-grow-sm" role="status" aria-hidden="true"></span>
                            A guardar...
                        </button>
                    }
                    else
                    {
                        <div class="row">
                            <button type="submit" style="margin:15px;width:100px" class="btn btn-primary">Guardar</button>
                        </div>
                        <span style="color:red;margin:2px">@_error</span>
                    }
                </div>

            </EditForm>
            <a style="cursor:pointer" @onclick="() => { ChoosedMenu = MenusLogin.Login; ChoosedMenuChanged.InvokeAsync(ChoosedMenu);}">Login</a>
        </div>
    </div>
</div>

<style type="text/css">

    .validationfieldstyle{
       font-size:8pt;
       color:salmon";
    }

    .inputValuesStyleDiv {
        width: 330px;
        float: left;
        margin: 10px 0 5px 0;
    }

    .labelStyle{
        float: left;
        width: 100px;
        text-align: left;
        height: 30px;
        font-size:9pt;
    }
    
    .elementStyle{
        background-color: white;
        border-color: lightgray;
        border-width: 0.5pt;
        margin: 0px;
        height: 38px;
        padding-left: 1px;
        padding-right: 1px;
        float: left;
        width: 220px;
        font-size:9pt;
    }
</style>

@code {
    UserRequest _user = new();
    bool _isSaving;
    string? _error;

    [Parameter]
    public MenusLogin ChoosedMenu { get; set; }

    [Parameter]
    public EventCallback<MenusLogin> ChoosedMenuChanged{ get; set; }

    private void Save(EditContext editContext)
    {
        try
        {
            _isSaving = true;

        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Erro ao registar utilizador");
            _error = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }
}
