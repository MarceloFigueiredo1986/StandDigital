@inherits PersonalDealsComponent

@attribute [StreamRendering]

<div class="row" style="padding:15px;">
    <input type="button" value="Criar anúncio" class="btn btn-primary" style="margin:15px;margin-top:5px;width:200px" @onclick="() => GotoCarDetails()" />

    <h5 style="color:white">Viaturas para venda ativas</h5>
    <Virtualize Items="@OpenDeals" Context="Car">
        <div style="margin:@_marginStr;margin-bottom:25px;float:@_float" class="card">
            <div class="row">
                <div class="leftdiv"><a><b>@Car.Marca</b></a></div>
                <div class="leftdiv"><a>@Car.Modelo </a></div>
                <div class="leftdiv"><a>@Car.Kms km <span style="position:absolute;right:110px">@Car.Cv cv</span></a></div>
                <div class="leftdiv"><a>@Car.Combustivel</a></div>
                <div class="leftdiv"><a><b>@Car.DiasParaFimAnuncio para terminar</b></a></div>
                @if (Car.Combustivel == Combustivel.Electrico.GetDescription() ||
                Car.Combustivel == Combustivel.HibridoGasolina.GetDescription() ||
                Car.Combustivel == Combustivel.HibridoGasoleo.GetDescription())
                {
                    <div class="leftdiv"><a>@Car.TipoCarregamento <span style="position:absolute;right:110px">@Car.Bateria Kw</span></a></div>
                }
                else
                {
                    <div class="leftdiv"><a>@Car.Cilindrada cc <span style="position:absolute;right:110px">@Car.Caixa</span></a></div>
                }
                <div style="max-width:100px;position:absolute;right:2px">
                    <img src="@Car.MainImage.ImageStringBase64()" height="93" style="position:absolute;right:0px;border-radius:45px" />
                </div>
                <div class="leftdiv"><input type="button" class="btn btn-secondary" value="Ver" @onclick="() => GotoCarDetails()" /></div>
            </div>
        </div>
    </Virtualize>
</div>

<div class="row" style="padding:15px;">
    <h5 style="color:white">Negócios terminados</h5>
    <Virtualize Items="@ClosedDeals" Context="Car">
        <div style="margin:@_marginStr;margin-bottom:25px;float:@_float" class="card">
            <div class="row">
                <div class="leftdiv"><a><b>@Car.Marca</b></a></div>
                <div class="leftdiv"><a>@Car.Modelo </a></div>
                <div class="leftdiv"><a>@Car.Kms km <span style="position:absolute;right:110px">@Car.Cv cv</span></a></div>
                <div class="leftdiv"><a>@Car.Combustivel</a></div>
                <div class="leftdiv">
                    <a>
                    @if (Car.TemProposta == 1)
                    {
                        <b style="color:forestgreen">Tem proposta</b>
                    }
                    else
                    {
                        <b>Sem proposta</b>
                    }
                    </a>
                </div>
                @if (Car.Combustivel == Combustivel.Electrico.GetDescription() ||
                Car.Combustivel == Combustivel.HibridoGasolina.GetDescription() ||
                Car.Combustivel == Combustivel.HibridoGasoleo.GetDescription())
                {
                    <div class="leftdiv"><a>@Car.TipoCarregamento <span style="position:absolute;right:110px">@Car.Bateria Kw</span></a></div>
                }
                else
                {
                    <div class="leftdiv"><a>@Car.Cilindrada cc <span style="position:absolute;right:110px">@Car.Caixa</span></a></div>
                }
                <div style="max-width:100px;position:absolute;right:2px">
                    <img src="@Car.MainImage.ImageStringBase64()" height="93" style="position:absolute;right:0px;border-radius:45px" />
                </div>
                <div class="leftdiv">
                    <input type="button" class="btn btn-secondary" value="Ver" @onclick="() => GotoCarDetails()" />
                </div>
            </div>
        </div>
    </Virtualize>
</div>