@page "/mercado"

@layout MainLayout

@attribute [Authorize(Roles = "admin,stand")]

<div style="padding:150px 2px 5px 2px">
    <ul class="nav nav-tabs">
        @foreach (var tab in _tabs)
        {
            var currentSelectedTab = tab.Key == _selectedTab ? "active" : "";

            <li class="nav-item">
                <span class="nav-link tabulador @currentSelectedTab" aria-current="page" @onclick="() => {_selectedTab = tab.Key;_menuNegocio = tab.Value;}">@tab.Key</span>
            </li>
        }
    </ul>

    @if (_menuNegocio != null)
    {
        <DynamicComponent Type="@_menuNegocio" />
    }

</div>

<style type="text/css">
    .tabulador{
    color:white;
    cursor:pointer;
    user-select:none;
    }

    .tabulador:hover{
    color:white;
    font-weight:bolder;
    border-style:none;
    }
</style>

@code {
    Dictionary<string, Type> _tabs = new(){
    {"Leilões", typeof(Leiloes)},
    {"Preço Certo", typeof(PrecoCerto) },
    { "Melhor Oferta", typeof(MelhorOferta)},
    { "Meus negócios", typeof(MeusNegocios)}
    };

    string _selectedTab = null!;
    private Type? _menuNegocio;

    protected override void OnInitialized() 
        => (_selectedTab, _menuNegocio) = (_tabs.First().Key, _tabs.First().Value);
}
