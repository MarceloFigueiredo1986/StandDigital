@page "/detalhesnegocio/{tiponegocio}/{carroid:int}"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Data.Sqlite
@using StandDigital.Auth

@inject ICarRepository carRepository
@inject ILogger<DetalhesNegocio> _logger
@inject AuthenticationStateProvider _authenticator
@inject SessionSettings _session 

@attribute [Authorize(Roles = "admin,stand")]

<StandDigital.Components.Components.ComponentLoader LoadingObj="_detalhesCarro">
    <Fragment>
        <div class="maindiv">
            <div class="row details">
                <div style="width:370px">
                    <StandDigital.Components.Components.ImageCarousel />
                    <h5 style="color:white"><b>Termina em:</b> @_detalhesCarro.Car.DiasParaFimAnuncio</h5>
                    <h4><b>Licitação atual: <span style="color:darkorange">@_detalhesCarro.CarSellHistory.BiggestBid €</span></b></h4>
                    <h4><b>Propostas feitas: <span style="color:darkorange">@_detalhesCarro.CarSellHistory.TotalBids</span></b></h4>
                    <h4><b>Licitador na frente: <span style="color:darkorange">@_detalhesCarro.CarSellHistory.Bidder</span></b></h4>
                    <br />
                </div>
                <div style="width:350px;">
                    <p><b>Marca / Modelo:</b> @_detalhesCarro.Car.Marca / @_detalhesCarro.Car.Modelo</p>
                    <p><b>Mês/Ano:</b> @_detalhesCarro.Car.MesRegisto.ToString().PadLeft(2,'0')/@_detalhesCarro.Car.Ano</p>
                    <p><b>Combustível:</b> @_detalhesCarro.Car.Combustivel</p>
                    <p><b>Kms:</b> @_detalhesCarro.Car.Kms</p>
                    <p><b>Origem:</b> @(_detalhesCarro.Car.Nacional == 1 ? "Nacional" : "Importado")</p>
                    @if (_detalhesCarro.Car.Combustivel != Combustivel.Electrico.GetDescription())
                    {
                        <p><b>Cilindrada:</b> @_detalhesCarro.Car.Cilindrada</p>
                        <p><b>Caixa:</b> @_detalhesCarro.Car.Caixa</p>
                    }else{
                        <p><b>Capacidade bateria:</b> @_detalhesCarro.Car.Bateria</p>
                        <p><b>Tipo carregamento:</b> @_detalhesCarro.Car.TipoCarregamento</p>
                    }
                    <p><b>Registos:</b> @(_detalhesCarro.Car.PrimeiroDono == 0 ? "2 ou + donos" : "1")</p>
                    <p><b>Origem:</b> @(_detalhesCarro.Car.Nacional == 0 ? "Importado" : "Nacional")</p>
                    <p><b>Problemas motor:</b> 
                        @(string.IsNullOrEmpty(_detalhesCarro.Car.ProblemasMotor) ? "Sem danos" : _detalhesCarro.Car.ProblemasMotor)
                    </p>
                    <p><b>Danos carroceria:</b> 
                        @(string.IsNullOrEmpty(_detalhesCarro.Car.Danos) ? "Sem danos" : _detalhesCarro.Car.Danos)
                    </p>
                    <p>
                        <b>Precisa Pneus:</b> @(_detalhesCarro.Car.PrecisaPneus == 1 ? "Sim" : "Não")
                    </p>
                    <p>
                        <b>Lotação:</b> @_detalhesCarro.Car.Lotacao
                    </p>
                    @foreach (var extra in _detalhesCarro.Extras)
                    {
                        <input style="margin:0.5px;font-size:8pt;height:20px;padding:2px" 
                        type="button" class="btn btn-primary" value="@extra" />
                    }
                </div>
                @if(_detalhesCarro.CarSellHistory.TotalBids == 0 || _detalhesCarro.CarSellHistory.Bidder != _sessionUser)
                {
                    <input type="button" class="btn btn-success comprarbutton" value="Licitar" />
                }
            </div>
        </div>
    </Fragment>
</StandDigital.Components.Components.ComponentLoader>

<style type="text/css">

    .comprarbutton{
        width:250px;
        margin:auto;
    }

    .maindiv{
        margin:145px 5px;
    }

    b{
        color:gray;
    }

    p{
        color:white;
    }

    .imgconfig{
        width:350px;
        height:350px;
    }

    .carouselstyle{
        height:350px;
        width:350px;
    }
</style>

    @code {
    [Parameter]
    public string TipoNegocio { get; set; }

    [Parameter]
    public int? CarroId { get; set; }

    CarWithExtrasAndImagesDto? _detalhesCarro;

    string _sessionUser = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (CarroId != null)
            {
                _detalhesCarro = await carRepository.GetCompleteCarAsync(CarroId.Value);
                _detalhesCarro.Photos.Add(_detalhesCarro.Car.ImageMin);
                var session_already_started = await _session.GetKey<Authentication.AuthenticationData>(SessionSettings.SessionKeys.UserLoggedData);
                _sessionUser = session_already_started.Name;
            }
        }
        catch(SqliteException sqlex)
        {
            _logger.LogError("Exception:{exception}", sqlex);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "GetCompleteCarAsync");
        }
    }
}