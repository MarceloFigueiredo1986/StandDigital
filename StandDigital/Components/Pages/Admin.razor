@page "/admin"

@attribute [StreamRendering]

@inject NavigationManager navman
@inject ILogger<Admin> _logger
@inject IMediator _mediator;
@inject SessionSettings _session

@attribute [Authorize(Roles = "admin,stand")]

<div class="row" style="padding:145px 2px 5px 2px;color:white">
    <h3>Stock de viaturas</h3>
    <input type="button" value="+" class="btn btn-success" style="max-width:35px;margin-left:15px;border-radius:25px" @onclick="() => GotoCarDetails()" />
    <Virtualize Items="@Cars" Context="Car">
        <div style="margin:@_marginStr;float:@_float;margin-bottom:15px;" class="card">
            <div class="row">
                <div class="leftdiv"><a><b>@Car.Marca</b></a></div>
                <div class="leftdiv"><a>@Car.Modelo </a></div>
                <div class="leftdiv"><a>@Car.Kms km <span style="position:absolute;right:110px">@Car.Cv cv</span></a></div>
                <div class="leftdiv"><a>@Car.Combustivel</a></div>
                <div class="leftdiv"><a>@Car.TipoCarregamento <span style="position:absolute;right:110px">@Car.Bateria Kw</span></a></div>
                <div class="leftdiv"><a>@Car.Cilindrada cc <span style="position:absolute;right:110px">@Car.Caixa</span></a></div>
                <div style="max-width:100px;position:absolute;right:2px">
                    <img height="93" style="position:absolute;right:0px;border-radius:45px" />
                </div>
            </div>
        </div>
    </Virtualize>
</div>

<style type="text/css">
    .card {
        height: 200px;
        width: 260px;
        background-color: whitesmoke;
        width: 250px;
        box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);
    }

    .floatingmenu{
        position:absolute;
        bottom:15px;
        right:15px;
    }

    .leftdiv{
    font-size:10pt;
    min-height:25px;
    min-width: 190px;
    margin: 2px;
    font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
}
</style>

@code {
    ICollection<CarEntity> Cars = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var session = await _session.GetKey<Authentication.AuthenticationData>(SessionSettings.SessionKeys.UserLoggedData);
            Cars = (await _mediator.Send(new UserOpenDealsRequest(session.IdUser))).ToArray();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex,null);
        }
    }

    [CascadingParameter]
    public int WindowWidth { get; set; }

    string? _marginStr;
    string? _float;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (WindowWidth == 0 || _marginStr is not null) return;

        (_marginStr,_float) = WindowWidth switch
        {
            > 560 => ($"{15}px","left"),
            <= 560 => ($"auto","none")
        };

        await InvokeAsync(StateHasChanged);
    }

    protected void GotoCarDetails(int? carid = null) => navman.NavigateTo($"managecar/{carid}");
}
