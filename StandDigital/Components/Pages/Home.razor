@page "/"
@attribute [StreamRendering]

<Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
    <Authorized>
        <section class="section main-banner" id="top" data-section="section1">
            <div autoplay muted loop id="bg-splash">
            </div>

            <div class="video-overlay header-text" style="background-color:transparent">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="caption">
                                <h2>O que procura?</h2>
                                <div class="main-button-red">
                                    <input type="text" placeholder="Mercedes E220 ..." style="text-align:left" />
                                    <div class="scroll-to-section" style="margin-top:15px"><a href="#contact">Procurar</a></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </Authorized>
    <NotAuthorized>
        <section class="section main-banner" id="top" data-section="section1" style="margin-top:10px">
            <div autoplay muted loop id="bg-splash">
            </div>

            <div class="video-overlay header-text" style="background-color:transparent">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="caption">
                                <h2>Pretende vender uma viatura ou moto rapidamente?</h2>
                                <h5 style="color:white">Veio ao sítio certo!</h5>
                                <p>
                                    <h7 style="color:white">
                                        Somos uma plataforma diferente, que permite os profissionais comercializarem
                                        viaturas e motos entre si, e obter rapidamente cotações de mercados para os seus produtos, criando uma rede
                                        que promove um sinergia comum.
                                        <p style="margin-top:15px"><b>Registe-se e esteja atento aos negócios que surgem.</b></p>
                                    </h7>
                                </p>
                                <div class="main-button-red">
                                    <div class="scroll-to-section" style="margin-top:15px"><a href="login">Registar</a></div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </NotAuthorized>
</Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
<StandDigital.Components.Components.CarCarrossel.CarCarrosselComponent TipoNegocio="EnumCarCarroselTipos.Destaques" />
