<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <TypeScriptCompileOnSaveEnabled>True</TypeScriptCompileOnSaveEnabled>
  </PropertyGroup>

  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <TypeScriptCompileOnSaveEnabled>True</TypeScriptCompileOnSaveEnabled>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="logs\**" />
    <Compile Remove="temporaryfiles\**" />
    <Content Remove="logs\**" />
    <Content Remove="temporaryfiles\**" />
    <EmbeddedResource Remove="logs\**" />
    <EmbeddedResource Remove="temporaryfiles\**" />
    <None Remove="logs\**" />
    <None Remove="temporaryfiles\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="database.sqlite" />
    <None Remove="database.sqlite-journal" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.Typeahead" Version="4.7.0" />
    <PackageReference Include="ErrorOr" Version="1.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="8.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.2" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StandDigital_HttpClient\StandDigital_HttpClient.csproj" />
    <ProjectReference Include="..\StandDigital_Shared\StandDigital_Shared.csproj" />
  </ItemGroup>

</Project>
