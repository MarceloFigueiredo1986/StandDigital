<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <TypeScriptCompileOnSaveEnabled>True</TypeScriptCompileOnSaveEnabled>
  </PropertyGroup>

  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <TypeScriptCompileOnSaveEnabled>True</TypeScriptCompileOnSaveEnabled>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c0646e77-ef16-46c9-be6b-c2e35a95131e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="logs\**" />
    <Compile Remove="temporaryfiles\**" />
    <Content Remove="logs\**" />
    <Content Remove="temporaryfiles\**" />
    <EmbeddedResource Remove="logs\**" />
    <EmbeddedResource Remove="temporaryfiles\**" />
    <None Remove="logs\**" />
    <None Remove="temporaryfiles\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="database.sqlite" />
    <None Remove="database.sqlite-journal" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="Blazored.Modal" Version="7.3.1" />
    <PackageReference Include="Blazored.Toast" Version="4.2.0" />
    <PackageReference Include="Blazored.Typeahead" Version="4.7.0" />
    <PackageReference Include="ErrorOr" Version="1.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="8.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="8.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.3" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.8" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StandDigital.Core\StandDigital.Core.csproj" />
    <ProjectReference Include="..\StandDigital_HttpClient\StandDigital_HttpClient.csproj" />
    <ProjectReference Include="..\StandDigital_Shared\StandDigital_Shared.csproj" />
  </ItemGroup>

</Project>
